{
  "name": "ledgerly",
  "private": true,
  "description": "A beautiful, scalable personal & household finance dashboard \u2014 built in stages as a learning project.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev dev:worker",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "e2e:build": "turbo run build --filter=@ledgerly/api --filter=@ledgerly/web",
    "e2e": "pnpm e2e:build && pnpm --filter @ledgerly/e2e e2e",
    "e2e:ui": "pnpm e2e:build && pnpm --filter @ledgerly/e2e e2e:ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && turbo run lint typecheck test",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @ledgerly/db db:generate",
    "db:migrate": "pnpm --filter @ledgerly/db db:migrate",
    "db:seed": "pnpm --filter @ledgerly/db db:seed",
    "db:reset": "pnpm --filter @ledgerly/db db:reset",
    "db:studio": "pnpm --filter @ledgerly/db db:studio"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
