# Copy to `deploy/.env` ON THE SERVER and fill in. Never commit the real file:
# it holds the keys to every user's data. (`.env` is git-ignored.)

# The image version to run: a git commit SHA built by CI. scripts/deploy.sh sets it.
IMAGE_TAG=
# Where the images live (GitHub Container Registry by default).
REGISTRY=ghcr.io/a7madalabed

# The public domain. Caddy gets an HTTPS certificate for it automatically.
# Its DNS A/AAAA record must point at this server. Use "localhost" to try locally.
SITE_ADDRESS=ledgerly.example.com

# Database password — long and random:
#   openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
POSTGRES_PASSWORD=

# Encrypts secrets at rest (2FA secrets). 32 random bytes, base64. Generate ONCE
# per environment and back it up safely: if it is lost, every 2FA secret is too.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Email (password resets, verification, invitations, alerts). Use your provider's
# SMTP credentials (Postmark, Amazon SES, Resend, Mailgun… all offer SMTP), and
# set up SPF and DKIM for MAIL_FROM's domain so messages aren't marked as spam.
MAIL_DRIVER=smtp
SMTP_URL=smtp://USERNAME:PASSWORD@smtp.example.com:587
MAIL_FROM=Ledgerly <no-reply@ledgerly.example.com>

# Who runs this copy: shown on the public privacy and terms pages. Fill in BEFORE you
# invite real users; a privacy policy with nobody to contact is half a policy.
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=

# Optional
LOG_LEVEL=info
WORKER_CONCURRENCY=4
# Serve the interactive API docs publicly (/api/docs). Off in production by default.
API_DOCS=false
