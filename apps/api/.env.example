# Copy this file to `.env` and adjust. Never commit the real `.env`.
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# PostgreSQL started by `pnpm db:up`.
DATABASE_URL=postgres://ledgerly:ledgerly@localhost:5432/ledgerly
# Connections per API instance. Total across instances must stay below Postgres' max_connections.
DATABASE_POOL_MAX=10
# Integration tests use a SEPARATE database (they wipe it). Created by docker/postgres/init.sql.
API_TEST_DATABASE_URL=postgres://ledgerly:ledgerly@localhost:5432/ledgerly_api_test
# Serve interactive API docs at /docs and the spec at /openapi.json.
API_DOCS=true
# Encrypts secrets at rest (2FA secrets). REQUIRED. Generate your own — never reuse
# a key across environments, and never commit a real one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Cookies are Secure (HTTPS-only) automatically when NODE_ENV=production.
# COOKIE_SECURE=false
# Set to true only behind a load balancer/proxy that sets X-Forwarded-For.
TRUST_PROXY=false
RATE_LIMIT_ENABLED=true
SESSION_TTL_DAYS=30
SESSION_IDLE_DAYS=14
