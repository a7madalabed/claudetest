{
  "name": "@ledgerly/e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Browser end-to-end tests: the real web app, API, worker and database, driven by Playwright.",
  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "servers": "tsx scripts/servers.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@ledgerly/db": "workspace:*",
    "@ledgerly/shared": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "otpauth": "9.5.2",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
